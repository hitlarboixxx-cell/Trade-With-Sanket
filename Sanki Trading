js = r'''function toggleTheme(){document.body.classList.toggle("light");localStorage.setItem("sankiTheme",document.body.classList.contains("light")?"light":"dark")}
if(localStorage.getItem("sankiTheme")==="light")document.body.classList.add("light");
function showPost(title){document.getElementById("modal-content").innerHTML=`<h2>${title}</h2><p>This is a demo article page. Replace this text with your own detailed trading article. You can ask AI to write and format each article for this website.</p><p><b>Educational note:</b> Trading involves risk. Always do your own research and use appropriate risk management.</p>`;document.getElementById("modal").classList.add("show")}
function closeModal(){document.getElementById("modal").classList.remove("show")}
function calculator(type){let html=`<h2>${type} Calculator</h2>`;if(type==="Position Size")html+=`<label>Capital ₹<input id="a" type="number" value="100000"></label><label>Risk %<input id="b" type="number" value="1"></label><label>Entry ₹<input id="c" type="number" value="100"></label><label>Stop Loss ₹<input id="d" type="number" value="95"></label><button class="btn" onclick="calcPos()">Calculate</button><div id="result"></div>`;else if(type==="Risk / Reward")html+=`<label>Entry ₹<input id="a" type="number" value="100"></label><label>Stop Loss ₹<input id="b" type="number" value="95"></label><label>Target ₹<input id="c" type="number" value="115"></label><button class="btn" onclick="calcRR()">Calculate</button><div id="result"></div>`;else html+=`<p>Simple P&L calculator coming next. You can customize this tool with your broker's charges.</p>`;document.getElementById("modal-content").innerHTML=html;document.getElementById("modal").classList.add("show")}
function calcPos(){let cap=+a.value,risk=+b.value,entry=+c.value,sl=+d.value;let r=cap*risk/100;let qty=Math.floor(r/Math.abs(entry-sl));result.innerHTML=`<h3>Position size: ${qty} units</h3><p>Approx. maximum planned risk: ₹${r.toFixed(2)}</p>`}
function calcRR(){let e=+a.value,s=+b.value,t=+c.value;let risk=Math.abs(e-s),reward=Math.abs(t-e);result.innerHTML=`<h3>Risk : Reward = 1 : ${(reward/risk).toFixed(2)}</h3>`}'''

